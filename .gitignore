# composer dependencies - install with `composer install`
/vendor/

# local auth config - contains AUTH_PASSWORD, never commit
# (copy user-config.inc.php-dist to create it)
/user-config.inc.php

# hotglue stores pages/uploads here as flat files - that's user data,
# not source. log.txt stays tracked as an empty placeholder.
/content/*
!/content/log.txt

# dev-only e2e tooling (see MODERNIZATION.md section 11) - hotglue itself
# stays no-build and has no runtime npm dependencies
/node_modules/
/test-results/
/playwright-report/

# hermetic content directory the e2e suite writes to, created and torn
# down per run - never the real /content
/content-e2e/

# Local shell helpers that export credentials - never tracked.
# (flash-v4-vars.sh was committed by accident on 2026-08-24; the token in it
# must be treated as compromised, since this repo is public.)
flash-*.sh
